# ── LLM ──────────────────────────────────
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o
# LLM_API_BASE_URL=https://api.openai.com/v1          # OpenAI default
# LLM_API_BASE_URL=https://api.poe.com/v1              # Poe
# LLM_API_BASE_URL=https://api.openai.com/v1           # Azure-like endpoints

# ── JIRA ─────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=your_email@company.com
JIRA_API_TOKEN=your_jira_token_here
JIRA_PROJECT_KEY=PROJ

# ── GITHUB ───────────────────────────────
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPO_OWNER=your_org
GITHUB_REPO_NAME=your_repo

# ── SLACK ────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0XXXXXXXXX
SLACK_SIGNING_SECRET=your_signing_secret

# ── APP CONFIG ───────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ── SPRINT CONFIG ────────────────────────
SPRINT_CHECK_INTERVAL_MINUTES=30
SPRINT_RISK_THRESHOLD=0.6
BLOCKER_KEYWORDS=blocked,blocker,stuck,waiting,dependency
